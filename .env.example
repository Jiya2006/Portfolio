# ==========================================
# Portfolio Environment Variables Template
# Copy this to .env and fill in your values
# ==========================================

# Contact Form & Email Visit Alerts (Web3Forms)
# Free instant access key from https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# View Counter Configuration
VITE_ENABLE_VIEW_COUNTER=true
VITE_COUNTER_NAMESPACE=jiya-baghel-portfolio

# Real-Time Visitor Alerts
VITE_NTFY_TOPIC=jiya_portfolio_visits_2028
VITE_NOTIFY_EMAIL=true
